# ── 应用 ───────────────────────────────────────────────
ENV=dev
DEBUG=true
LOG_LEVEL=DEBUG
PORT=8090
HOST=127.0.0.1

# ── 数据库 ─────────────────────────────────────────────
# Postgres: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/my_trip_planner

# ── 认证 ───────────────────────────────────────────────
# JWT 签名密钥。生产环境必须显式配置（可用: uv run python -c "import secrets;print(secrets.token_hex(32))"）
JWT_SECRET=
# token 有效期（分钟），默认 7 天
# JWT_EXPIRE_MINUTES=10080

# ── Google 登录（OAuth） ───────────────────────────────
# 前端 Google Identity Services 的 Client ID（用于校验 ID Token 的 aud）
GOOGLE_CLIENT_ID=
# OAuth Client Secret（当前 ID Token 流程可留空，预留给 Authorization Code flow）
GOOGLE_CLIENT_SECRET=

# ── LLM Provider ───────────────────────────────────────
# auto: 按已配置的 key 自动选择（deepseek → openai → ollama）
# deepseek / openai / ollama: 显式指定
# 注意：不再有 mock —— 未配置任何 key 时调用 /planner/plan 会明确报错
DEFAULT_LLM_PROVIDER=auto

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 本地 Ollama：OLLAMA_MODEL 必须与本机 `ollama list` 的实际模型名一致
#（OllamaProvider.healthcheck 会在兜底链/调用前校验模型存在性，模型缺失即视为不可用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=batiai/gemma4-12b:q4

# ── 高德地图（POI 搜索 / 天气） ─────────────────────────
# 真实景点/酒店搜索 + 天气预报依赖高德 Web 服务 key（https://lbs.amap.com 申请）
# 配置后 AttractionSearchAgent / HotelAgent 走高德 POI，WeatherQueryAgent 走高德天气；
# 未配置时自动降级：景点 → Tavily，天气 → wttr.in
AMAP_API_KEY=

# ── 搜索（Tavily，高德未配置时的景点/餐厅降级源） ─────────
TAVILY_API_KEY=

# ── Agent ──────────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_MAX_CORRECTIONS=3

# ── 任务可靠性（超时 / 恢复） ──────────────────────────
# running 超过该秒数视为进程崩溃遗留 → 启动时标记 failed
TASK_STALE_RUNNING_SECONDS=300
# pending 超过该秒数视为提交后进程崩溃/队列未消费 → 启动时标记 failed
TASK_PENDING_STALE_SECONDS=300

# ── CORS ───────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]