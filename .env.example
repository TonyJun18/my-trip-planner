# ── my-trip-planner · Docker 部署环境变量模板 ──────────────
# 用法：cp .env.example .env，然后按要求填写。
# 本文件供仓库根目录的 docker-compose.yml 使用（backend 容器 env_file 加载，
# 同时参与 compose 的 ${VAR:-default} 插值）。backend/.env.example 是本地开发用，勿混用。

# ── 数据库（compose 的 db 服务 + backend 的 DATABASE_URL 共用） ──
# 仅本机演示可用默认值；公网部署必须改
POSTGRES_PASSWORD=postgres
# 本机已有 Postgres 时，宿主机暴露端口（避免 5432 冲突，默认 5433）
POSTGRES_PORT=5433

# ── 认证 ───────────────────────────────────────────────
# 生产必须设置：openssl rand -hex 32 （或 python3 -c "import secrets;print(secrets.token_hex(32))"）
# 不设置则每次重启生成随机密钥，已签发 token 全部失效
JWT_SECRET=

# ── LLM Provider（都不配 → 规划接口会明确报错，见 README 已知局限） ──
DEFAULT_LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# 本地模型（可选）
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# ── 高德地图（POI/天气；不配自动降级 Tavily / wttr.in） ──
AMAP_API_KEY=

# ── 搜索降级源 ─────────────────────────────────────────
TAVILY_API_KEY=

# ── CORS（compose 默认限定 http://localhost:8080；改域名/端口时同步改） ──
# CORS_ORIGINS=["http://localhost:8080"]

# ── 应用（compose 已在 environment 段兜底，一般无需改） ──
ENV=prod
DEBUG=false
LOG_LEVEL=INFO